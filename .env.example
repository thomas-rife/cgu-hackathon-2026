# Terminal-only routing experiment (test.js).
ARCGIS_KEY=your_arcgis_api_key

# Browser map: requires access to the ArcGIS Basemap Styles service.
# NEXT_PUBLIC_ values are visible in the browser; use a referrer-restricted key.
NEXT_PUBLIC_ARCGIS_API_KEY=your_arcgis_basemap_api_key

# Server-only local model connection (LM Studio's OpenAI-compatible server).
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=bolt-instruct-v2
